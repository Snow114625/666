.acc-op-btn { color: var(--text-muted); padding: 6px; min-width: 32px; min-height: 32px; display: flex; align-items: center; justify-content: center; border-radius: 6px; }

.acc-op-btn:active { background: var(--bg-input); }

.acc-op-btn svg { width: 15px; height: 15px; }

.history-summary { background: var(--bg-input); border-radius: var(--radius-sm); padding: 10px 14px; margin-bottom: 10px; font-size: 0.8rem; color: var(--text-secondary); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 6px; }

.pwa-hint { background: linear-gradient(135deg, var(--accent-writing-bg), var(--accent-drawing-bg)); border: 1px solid var(--border); border-radius: var(--radius); padding: 14px 16px; margin-bottom: 16px; font-size: 0.82rem; color: var(--text-secondary); display: flex; gap: 10px; align-items: flex-start; line-height: 1.5; }

.pwa-hint svg { width: 20px; height: 20px; flex-shrink: 0; margin-top: 1px; }

.pwa-hint strong { color: var(--text); }

.pwa-hint .close-hint { margin-left: auto; color: var(--text-muted); padding: 2px 6px; font-size: 1.1rem; line-height: 1; }

@media (min-width: 768px) {
  .main-content { padding: 24px 32px 60px; }
  .app-header { padding: 18px 32px 12px; }
  .tab-bar { max-width: 480px; }
  .record-card:hover { background: var(--bg-card-hover); }
}

::-webkit-scrollbar { width: 6px; height: 6px; }

::-webkit-scrollbar-track { background: transparent; }

::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }

::-webkit-scrollbar-thumb:hover { background: var(--border-active); }
